# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
zstyle ':omz:update' mode auto
plugins=(git z)
# Docker completions must be on fpath before Oh My Zsh runs compinit.
fpath=("$HOME/.docker/completions" $fpath)
source "$ZSH/oh-my-zsh.sh"

export PATH="/opt/homebrew/bin:$PATH"

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# PostgreSQL 17
export PATH="/opt/homebrew/opt/postgresql@17/bin:$PATH"
export LDFLAGS="-L/opt/homebrew/opt/postgresql@17/lib"
export CPPFLAGS="-I/opt/homebrew/opt/postgresql@17/include"

# Google Cloud SDK from the gcloud-cli cask
gcloud_sdk="/opt/homebrew/share/google-cloud-sdk"
[ -f "$gcloud_sdk/path.zsh.inc" ] && . "$gcloud_sdk/path.zsh.inc"
[ -f "$gcloud_sdk/completion.zsh.inc" ] && . "$gcloud_sdk/completion.zsh.inc"
unset gcloud_sdk

alias docker-compose='docker compose'

# Secrets come from the macOS Keychain, never from this file. See README.
if token="$(security find-generic-password -s shopify-cli-theme-token -w 2>/dev/null)"; then
	export SHOPIFY_CLI_THEME_TOKEN="$token"
fi
unset token

command -v whystack >/dev/null && whystack status --quiet
