{
  "agentPushNotifEnabled": false,
  "askUserQuestionTimeout": "never",
  "autoContinueAtUsageLimit": true,
  "autoMemoryEnabled": false,
  "autoUpdatesChannel": "latest",
  "editorMode": "normal",
  "effortLevel": "high",
  "enabledPlugins": {
    "blast-radius@whystack": true,
    "brain-dump@whystack": true,
    "cache-tax@whystack": true,
    "canva@claude-plugins-official": true,
    "cc-plugin-telemetry@builtin": false,
    "cc-plugin-you-should-know@builtin": true,
    "codex@openai-codex": true,
    "decision-tree@whystack": true,
    "diagram-pane@whystack": true,
    "filetree@whystack": true,
    "helper-desk@whystack": true,
    "humanizer@humanizer": true,
    "pstack@cursor-plugins": true,
    "replay-theater@whystack": true
  },
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "repo": "cursor/plugins",
        "source": "github"
      }
    },
    "humanizer": {
      "source": {
        "repo": "blader/humanizer",
        "source": "github"
      }
    },
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    },
    "shopify-ai-toolkit": {
      "source": {
        "repo": "Shopify/shopify-ai-toolkit",
        "source": "github"
      }
    }
  },
  "inputNeededNotifEnabled": false,
  "model": "claude-opus-5-5",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "outputStyle": "ASD-STE-100",
  "remoteControlAtStartup": true,
  "showTurnDuration": true,
  "skillOverrides": {
    "brainstorming": "off",
    "dispatching-parallel-agents": "off",
    "executing-plans": "off",
    "find-skills": "off",
    "finishing-a-development-branch": "off",
    "improve-codebase-architecture": "off",
    "receiving-code-review": "off",
    "requesting-code-review": "off",
    "subagent-driven-development": "off",
    "systematic-debugging": "off",
    "test-driven-development": "off",
    "using-git-worktrees": "off",
    "using-superpowers": "off",
    "verification-before-completion": "off",
    "writing-plans": "off",
    "writing-skills": "off"
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "bash ~/.claude/statusline.sh",
    "type": "command"
  },
  "theme": "auto",
  "tui": "fullscreen",
  "verbose": false,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true,
  "worktree": {
    "baseRef": "head"
  }
}
